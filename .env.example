# Local Python execution; Compose supplies its own service URLs.
MONGO_URL=mongodb://localhost:27018
MONGO_DATABASE=ecommerce_insights
REDIS_URL=redis://localhost:6380/0
# Cache expires after one day; active counts are rebuilt and expire after 120s.
CACHE_TTL_SECONDS=86400
# Concurrent stages per worker process.
WORKER_CONCURRENCY=2
# Each stage fails independently; retries use exponential backoff.
FAILURE_PROBABILITY=0.1
MAX_STAGE_ATTEMPTS=3
# Fraction of the real stage duration. Keep 1 for assignment timings;
# 0 makes stages instant, which is what the tests use.
SIMULATION_SCALE=1
